FRED_API_KEY=your_key_here

# Schwab OAuth (see README for setup)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Encryption key for Schwab tokens at rest (required in production)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCHWAB_ENCRYPTION_KEY=

# Alpha Vantage — free key for earnings calendar (25 req/day)
# Get one at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Authentication (opt-in — app works without these, set all 3 to enable)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Run: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Comma-separated GitHub usernames (empty = allow all authenticated users)
ALLOWED_USERS=

# Production deployment (used by docker-compose.prod.yml)
DOMAIN=regression.yourdomain.com

# QA environment (issue #330): the prod stack now joins a shared external
# Docker network `caddy_net` so the prod Caddy can reverse-proxy the QA stack
# (qa-backend / qa-frontend) for the qa.${DOMAIN} site block. Create it once on
# the box: `docker network create caddy_net`. The QA stack uses its OWN env file
# — see deploy/qa/.env.template and deploy/qa/README.md. No QA-specific var is
# needed here; the QA hostname is qa.${DOMAIN} (rendered in Caddy as qa.{$DOMAIN}).

# Optional: basic auth (leave empty for open access)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Axiom centralized logging (optional)
# When AXIOM_API_TOKEN is set, backend logs are also shipped to the Axiom
# dataset named AXIOM_DATASET. When unset, logging is stdout-only (today's
# behavior — Loki/Grafana continue to capture container stdout in prod).
# Get a token at https://app.axiom.co (Settings -> API Tokens) with Ingest
# permission on the dataset. See deploy/LOGGING.md for full setup.
AXIOM_API_TOKEN=
AXIOM_DATASET=regression-tool
